# /etc/inittab for Gastinel Alpine Linux
# Direct graphical launch without tty text login prompt

::sysinit:/sbin/openrc sysinit
::wait:/sbin/openrc boot
::wait:/sbin/openrc default

# tty1 launches Gastinel GUI directly
tty1::respawn:/usr/bin/gastinel-session

# Fallback debug ttys on Alt+F2 / Alt+F3
tty2::respawn:/sbin/getty 38400 tty2
tty3::respawn:/sbin/getty 38400 tty3

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
