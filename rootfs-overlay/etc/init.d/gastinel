#!/sbin/openrc-run
# OpenRC service script for Gastinel Desktop

description="Gastinel Wayland Desktop Environment"
supervisor="supervise-daemon"
command="/usr/bin/gastinel-desktop"
# Compte créé par l'OOBE (voir /etc/conf.d/gastinel)
GASTINEL_USER="${GASTINEL_USER:-gastinel}"
command_user="${GASTINEL_USER}:seat"

depend() {
    need udev seatd localmount
    after networking
    provide display-manager
}

start_pre() {
    # Ensure seatd socket is accessible
    if [ ! -S /run/seatd.sock ]; then
        eerror "seatd is not running! Starting seatd..."
        rc-service seatd start
    fi
}
